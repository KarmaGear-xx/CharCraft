{
  "name": "charcraft",
  "private": true,
  "version": "0.1.0",
  "description": "CharCraft — SillyTavern character card desktop tool",
  "main": "out/main/index.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "pnpm build:main && pnpm build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package": "pnpm build && electron-builder --win portable"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "gpt-tokenizer": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  }
}